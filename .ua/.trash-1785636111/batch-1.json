{
  "nodes": [
    {
      "id": "file:scanner/camera.py",
      "type": "file",
      "name": "camera.py",
      "filePath": "scanner/camera.py",
      "summary": "Manages the RealSense D455 video pipeline: starts depth+color streaming, builds the depth post-processing filter chain and depth-to-color alignment block, and locks auto-exposure/white-balance so TSDF colors stay consistent across a scan.",
      "tags": ["camera-io", "sensor-pipeline", "depth-processing", "calibration", "hardware"],
      "complexity": "moderate",
      "languageNotes": "Filter ordering is deliberate: spatial/temporal filters run on the native-resolution depth frame before rs.align, since aligning first resamples depth to the color viewpoint and breaks the filters' assumptions."
    },
    {
      "id": "function:scanner/camera.py:start_camera",
      "type": "function",
      "name": "start_camera",
      "filePath": "scanner/camera.py",
      "lineRange": [15, 62],
      "summary": "Starts RealSense depth+color streaming, applies the high-accuracy visual preset when supported, builds the depth filter chain and align block, and computes the color-stream intrinsics as an Open3D tensor.",
      "tags": ["initialization", "camera-io", "hardware", "realsense"],
      "complexity": "moderate"
    },
    {
      "id": "function:scanner/camera.py:filter_and_align",
      "type": "function",
      "name": "filter_and_align",
      "filePath": "scanner/camera.py",
      "lineRange": [65, 93],
      "summary": "Applies the spatial/temporal depth filters to the original depth frame before aligning to color, falling back once to filter-after-align on librealsense builds that reject frameset input to processing blocks.",
      "tags": ["depth-processing", "filtering", "error-handling"],
      "complexity": "moderate"
    },
    {
      "id": "function:scanner/camera.py:lock_exposure",
      "type": "function",
      "name": "lock_exposure",
      "filePath": "scanner/camera.py",
      "lineRange": [96, 117],
      "summary": "Freezes the RGB sensor's auto-exposure and auto white-balance at their current settled values so recorded colors stay consistent across a scan.",
      "tags": ["camera-io", "calibration", "hardware"],
      "complexity": "simple"
    },
    {
      "id": "file:scanner/capture.py",
      "type": "file",
      "name": "capture.py",
      "filePath": "scanner/capture.py",
      "summary": "Defines CaptureSession, the realtime capture loop that orchestrates camera+IMU acquisition, IMU-primed frame-to-model tracking with relocalization, TSDF integration, background frame recording, and crash-safe finalization into the offline refinement pipeline.",
      "tags": ["slam", "state-machine", "orchestrator", "realtime", "tracking"],
      "complexity": "complex",
      "languageNotes": "Central per-frame state machine coordinating six sibling modules; every exit path (quit, Ctrl+C, or exception) flushes the writer and saves tracked poses so --refine-only can always rebuild the scan offline."
    },
    {
      "id": "class:scanner/capture.py:CaptureSession",
      "type": "class",
      "name": "CaptureSession",
      "filePath": "scanner/capture.py",
      "lineRange": [42, 360],
      "summary": "Owns the camera, IMU, SLAM model, and all per-scan state; implements the full per-frame pipeline (grab, filter+align, track, relocalize, integrate, record, HUD) plus crash-safe shutdown and finalization into offline refinement.",
      "tags": ["slam", "state-machine", "orchestrator", "realtime"],
      "complexity": "complex"
    },
    {
      "id": "function:scanner/capture.py:__init__",
      "type": "function",
      "name": "__init__",
      "filePath": "scanner/capture.py",
      "lineRange": [45, 81],
      "summary": "Initializes a capture session: starts the camera and optional IMU, allocates the SLAM model and raycast frames, and sets up the frames directory and background FrameWriter for recording.",
      "tags": ["initialization", "setup", "slam"],
      "complexity": "moderate"
    },
    {
      "id": "function:scanner/capture.py:warm_up",
      "type": "function",
      "name": "warm_up",
      "filePath": "scanner/capture.py",
      "lineRange": [85, 93],
      "summary": "Lets auto-exposure settle over a few frames, then locks it and writes the scan metadata JSON.",
      "tags": ["calibration", "setup"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/capture.py:run",
      "type": "function",
      "name": "run",
      "filePath": "scanner/capture.py",
      "lineRange": [95, 107],
      "summary": "The main capture loop: repeatedly steps the session until it ends, handling keyboard interrupt and unhandled exceptions, and always calling shutdown.",
      "tags": ["main-loop", "error-handling"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/capture.py:_shutdown",
      "type": "function",
      "name": "_shutdown",
      "filePath": "scanner/capture.py",
      "lineRange": [109, 118],
      "summary": "Crash-safe teardown: stops the camera/IMU streams, closes windows, flushes the background writer, and saves tracked poses to disk.",
      "tags": ["cleanup", "crash-safety"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/capture.py:_step",
      "type": "function",
      "name": "_step",
      "filePath": "scanner/capture.py",
      "lineRange": [122, 156],
      "summary": "Processes one camera frame: grabs and filters/aligns it, tracks or relocalizes the pose, integrates into the TSDF on success, updates the FPS estimate, and renders the HUD.",
      "tags": ["frame-processing", "tracking", "control-flow"],
      "complexity": "moderate"
    },
    {
      "id": "function:scanner/capture.py:_prepare",
      "type": "function",
      "name": "_prepare",
      "filePath": "scanner/capture.py",
      "lineRange": [158, 176],
      "summary": "Converts raw librealsense depth/color frames to numpy arrays and device images, clipping depth outside the configured min/max range.",
      "tags": ["preprocessing", "depth-processing"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/capture.py:_track",
      "type": "function",
      "name": "_track",
      "filePath": "scanner/capture.py",
      "lineRange": [178, 208],
      "summary": "Tracks the current frame against the raycast model frame, via IMU-primed RGB-D odometry when available or Open3D's frame-to-model tracker otherwise, and applies fitness/RMSE/step-size health checks before accepting the pose.",
      "tags": ["tracking", "odometry", "health-check"],
      "complexity": "moderate"
    },
    {
      "id": "function:scanner/capture.py:_relocalize",
      "type": "function",
      "name": "_relocalize",
      "filePath": "scanner/capture.py",
      "lineRange": [210, 227],
      "summary": "Attempts to re-acquire tracking by matching the current frame against the stored keyframe ring buffer, newest first, accepting the first match that clears the relocalization fitness/RMSE thresholds.",
      "tags": ["relocalization", "recovery", "tracking"],
      "complexity": "moderate"
    },
    {
      "id": "function:scanner/capture.py:_integrate",
      "type": "function",
      "name": "_integrate",
      "filePath": "scanner/capture.py",
      "lineRange": [229, 252],
      "summary": "Fuses the tracked frame into the TSDF model, refreshes the raycast frame, records the pose and periodic keyframes for relocalization, and queues the frame for background disk recording.",
      "tags": ["tsdf", "integration", "keyframes"],
      "complexity": "moderate"
    },
    {
      "id": "function:scanner/capture.py:_hud",
      "type": "function",
      "name": "_hud",
      "filePath": "scanner/capture.py",
      "lineRange": [256, 290],
      "summary": "Renders the live preview window with tracking status and position overlay, and handles quit/snapshot/reset key presses.",
      "tags": ["ui", "visualization", "input-handling"],
      "complexity": "moderate"
    },
    {
      "id": "function:scanner/capture.py:_reset",
      "type": "function",
      "name": "_reset",
      "filePath": "scanner/capture.py",
      "lineRange": [292, 311],
      "summary": "Restarts the reconstruction from scratch: fresh SLAM model, cleared trajectory/keyframes/IMU accumulator, and a cleared frames directory with fresh metadata.",
      "tags": ["reset", "state-management"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/capture.py:finalize",
      "type": "function",
      "name": "finalize",
      "filePath": "scanner/capture.py",
      "lineRange": [315, 360],
      "summary": "Post-capture finalization: saves the trajectory and metadata, then either exports the realtime TSDF directly or runs the full offline refinement pipeline, printing crash-recovery instructions on failure.",
      "tags": ["finalization", "offline-processing", "error-handling"],
      "complexity": "moderate"
    },
    {
      "id": "file:scanner/frameio.py",
      "type": "file",
      "name": "frameio.py",
      "filePath": "scanner/frameio.py",
      "summary": "Handles frame and metadata I/O: a background-threaded FrameWriter that saves depth/color PNGs and JPEGs without blocking the tracking loop, plus loaders for recorded RGB-D frames and the JSON scan metadata used by the offline refinement pipeline.",
      "tags": ["file-io", "threading", "serialization", "persistence"],
      "complexity": "moderate"
    },
    {
      "id": "class:scanner/frameio.py:FrameWriter",
      "type": "class",
      "name": "FrameWriter",
      "filePath": "scanner/frameio.py",
      "lineRange": [24, 83],
      "summary": "Background-threaded frame writer that queues depth/color images for disk writes so PNG/JPEG encoding never blocks the realtime tracking loop; blocks with rate-limited warnings rather than dropping frames when the disk falls behind.",
      "tags": ["threading", "file-io", "producer-consumer"],
      "complexity": "moderate"
    },
    {
      "id": "function:scanner/frameio.py:_run",
      "type": "function",
      "name": "_run",
      "filePath": "scanner/frameio.py",
      "lineRange": [50, 61],
      "summary": "Background thread loop that pulls queued items and writes each frame to disk with cv2.imwrite, exiting on a None sentinel.",
      "tags": ["threading", "file-io"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/frameio.py:drain",
      "type": "function",
      "name": "drain",
      "filePath": "scanner/frameio.py",
      "lineRange": [63, 73],
      "summary": "Discards all currently queued frames and waits for any in-flight write to finish, used before clearing the frames directory on reconstruction reset.",
      "tags": ["cleanup", "threading"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/frameio.py:load_rgbd",
      "type": "function",
      "name": "load_rgbd",
      "filePath": "scanner/frameio.py",
      "lineRange": [86, 97],
      "summary": "Loads a recorded depth/color frame pair from disk by index and returns them as an Open3D RGBDImage on the target device, or None if either file is missing.",
      "tags": ["file-io", "deserialization"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/frameio.py:build_meta",
      "type": "function",
      "name": "build_meta",
      "filePath": "scanner/frameio.py",
      "lineRange": [100, 112],
      "summary": "Collects camera intrinsics, depth scale, and capture parameters into a plain dict so recorded frames can be reprocessed later without the camera.",
      "tags": ["serialization", "metadata"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/frameio.py:save_meta",
      "type": "function",
      "name": "save_meta",
      "filePath": "scanner/frameio.py",
      "lineRange": [115, 118],
      "summary": "Writes the scan metadata dict built by build_meta as JSON to the given path.",
      "tags": ["serialization", "file-io"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/frameio.py:load_meta",
      "type": "function",
      "name": "load_meta",
      "filePath": "scanner/frameio.py",
      "lineRange": [121, 124],
      "summary": "Reads a scan metadata JSON file previously written by save_meta.",
      "tags": ["deserialization", "file-io"],
      "complexity": "simple"
    },
    {
      "id": "file:scanner/mapping.py",
      "type": "file",
      "name": "mapping.py",
      "filePath": "scanner/mapping.py",
      "summary": "TSDF voxel block grid operations: extracting and exporting point clouds/meshes in 8-bit-RGB legacy format for external viewer compatibility, and the offline re-integration pass that re-fuses recorded frames at a finer voxel resolution.",
      "tags": ["tsdf", "point-cloud", "reconstruction", "mesh-export"],
      "complexity": "moderate",
      "languageNotes": "Export deliberately goes through Open3D's legacy writer (uchar RGB) instead of the tensor writer (float RGB), since most external viewers render float colors as no color at all."
    },
    {
      "id": "function:scanner/mapping.py:extract_cloud",
      "type": "function",
      "name": "extract_cloud",
      "filePath": "scanner/mapping.py",
      "lineRange": [19, 22],
      "summary": "Extracts a point cloud from a TSDF voxel block grid and moves it to the CPU device.",
      "tags": ["tsdf", "point-cloud", "extraction"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/mapping.py:save_cloud",
      "type": "function",
      "name": "save_cloud",
      "filePath": "scanner/mapping.py",
      "lineRange": [25, 51],
      "summary": "Extracts, optionally denoises, and saves a TSDF point cloud (and optional mesh) to disk in 8-bit RGB legacy PLY format.",
      "tags": ["point-cloud", "export", "denoising"],
      "complexity": "moderate"
    },
    {
      "id": "function:scanner/mapping.py:refine",
      "type": "function",
      "name": "refine",
      "filePath": "scanner/mapping.py",
      "lineRange": [54, 88],
      "summary": "Re-fuses all recorded frames into a fresh, finer-resolution voxel block grid by streaming depth/color images from disk one at a time, skipping any frames that were never flushed to disk.",
      "tags": ["tsdf", "offline-processing", "reconstruction"],
      "complexity": "moderate"
    },
    {
      "id": "file:scanner/pipeline.py",
      "type": "file",
      "name": "pipeline.py",
      "filePath": "scanner/pipeline.py",
      "summary": "Offline reconstruction pipeline shared by live capture and --refine-only: optimizes the tracked trajectory via pose-graph optimization, re-integrates recorded frames, saves the point cloud, and can rebuild a full scan from a previous session's frames directory without touching the camera.",
      "tags": ["offline-processing", "pose-graph", "recovery", "entry-point"],
      "complexity": "moderate"
    },
    {
      "id": "function:scanner/pipeline.py:offline_pipeline",
      "type": "function",
      "name": "offline_pipeline",
      "filePath": "scanner/pipeline.py",
      "lineRange": [22, 38],
      "summary": "Runs the offline half of reconstruction: optimizes the tracked trajectory via pose-graph optimization (unless disabled), re-integrates all frames at the fine voxel size, and saves the final point cloud.",
      "tags": ["offline-processing", "pose-graph", "reconstruction"],
      "complexity": "moderate"
    },
    {
      "id": "function:scanner/pipeline.py:view_result",
      "type": "function",
      "name": "view_result",
      "filePath": "scanner/pipeline.py",
      "lineRange": [41, 45],
      "summary": "Opens a saved point cloud file in the Open3D visualization window.",
      "tags": ["visualization", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/pipeline.py:refine_only",
      "type": "function",
      "name": "refine_only",
      "filePath": "scanner/pipeline.py",
      "lineRange": [48, 71],
      "summary": "Entry point for the --refine-only recovery flow: loads a previous session's metadata and poses from its frames directory and reruns the offline pipeline without touching the camera.",
      "tags": ["recovery", "entry-point", "offline-processing"],
      "complexity": "moderate"
    },
    {
      "id": "file:scanner/tracking.py",
      "type": "file",
      "name": "tracking.py",
      "filePath": "scanner/tracking.py",
      "summary": "Shared RGB-D odometry helper wrapping Open3D's multi-scale hybrid odometry with tuned convergence criteria, used by realtime tracking, relocalization, and the pose graph for any tracking path that needs an initial transformation.",
      "tags": ["odometry", "tracking", "utility", "open3d"],
      "complexity": "simple",
      "languageNotes": "Model.track_frame_to_model does not accept an initial transformation, so every path needing one (IMU prior, relocalization, loop-closure verification) is routed through this lower-level wrapper instead."
    },
    {
      "id": "function:scanner/tracking.py:odo_criteria",
      "type": "function",
      "name": "odo_criteria",
      "filePath": "scanner/tracking.py",
      "lineRange": [17, 25],
      "summary": "Lazily builds and caches multi-scale convergence criteria (6/3/1 iterations) matching the realtime tracker's cheaper-than-default settings.",
      "tags": ["odometry", "configuration", "caching"],
      "complexity": "simple"
    },
    {
      "id": "function:scanner/tracking.py:rgbd_odometry",
      "type": "function",
      "name": "rgbd_odometry",
      "filePath": "scanner/tracking.py",
      "lineRange": [28, 52],
      "summary": "Thin wrapper over Open3D's hybrid multi-scale RGB-D odometry that accepts an initial transformation guess, used wherever tracking needs an init such as the IMU prior, relocalization, or loop-closure verification.",
      "tags": ["odometry", "tracking", "utility"],
      "complexity": "simple"
    }
  ],
